# Archivo de configuración de entorno para el Sistema POS
# Copia este archivo como .env y configura las variables según tu entorno

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================

# Clave secreta para Flask (CRÍTICO - mantener seguro)
# Genera una nueva con: python secret_keys.py
SECRET_KEY=pos-secret-key-2024-development

# Configuración HTTPS
USE_HTTPS=false
HTTPS_PORT=5443
SSL_CERT_PATH=certificates/cert.pem
SSL_KEY_PATH=certificates/key.pem

# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================================================

# Puerto del servidor (HTTP)
PORT=5000

# Entorno de ejecución (development, production)
FLASK_ENV=development

# Host del servidor (0.0.0.0 para acceso externo, 127.0.0.1 para solo local)
FLASK_HOST=0.0.0.0

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================

# Nombre del archivo de base de datos
DB_NAME=database.db

# =============================================================================
# CONFIGURACIÓN DE ARCHIVOS
# =============================================================================

# Directorio para subida de imágenes
UPLOAD_FOLDER=static/img

# Tamaño máximo de archivo (en bytes)
MAX_CONTENT_LENGTH=16777216

# =============================================================================
# CONFIGURACIONES ADICIONALES
# =============================================================================

# Habilitar modo debug (solo para desarrollo)
DEBUG=true

# Tiempo de vida de sesión (en horas)
SESSION_LIFETIME_HOURS=8

# =============================================================================
# INSTRUCCIONES DE USO
# =============================================================================
# 1. Copia este archivo como .env en el directorio raíz del proyecto
# 2. Modifica las variables según tu entorno
# 3. Nunca compartas el archivo .env en repositorios públicos
# 4. Para cargar automáticamente, instala python-dotenv:
#    pip install python-dotenv
# 5. Luego añade al inicio de app_modular.py:
#    from dotenv import load_dotenv
#    load_dotenv()

# =============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# =============================================================================

# Para producción:
# FLASK_ENV=production
# DEBUG=false
# USE_HTTPS=true
# SECRET_KEY=tu_clave_super_segura_aqui

# Para desarrollo local:
# FLASK_ENV=development  
# DEBUG=true
# PORT=5000
# FLASK_HOST=127.0.0.1

# Para acceso en red local:
# FLASK_HOST=0.0.0.0
# PORT=5000
